{
  "name": "shadowverse-wb-sim",
  "version": "1.0.0",
  "description": "Shadowverse: Worlds Beyond 非公式対戦シミュレータ",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "cards": "node scripts/convert-cards.ts",
    "sim": "node scripts/vite-run.mjs scripts/simulate-main.ts",
    "game": "node scripts/vite-run.mjs scripts/game-main.ts",
    "sim-report": "node scripts/vite-run.mjs scripts/sim-report-main.ts",
    "tune": "node scripts/vite-run.mjs scripts/tune-main.ts",
    "compare": "node scripts/vite-run.mjs scripts/compare-main.ts",
    "spsa": "node scripts/vite-run.mjs scripts/spsa-main.ts",
    "rhino-compare": "node scripts/vite-run.mjs scripts/rhino-compare-main.ts",
    "af-compare": "node scripts/vite-run.mjs scripts/rhino-compare-main.ts --subject af",
    "spellwitch-compare": "node scripts/vite-run.mjs scripts/rhino-compare-main.ts --subject spellwitch",
    "bishop-compare": "node scripts/vite-run.mjs scripts/rhino-compare-main.ts --subject bishop",
    "dragon-compare": "node scripts/vite-run.mjs scripts/rhino-compare-main.ts --subject dragon",
    "nightmare-compare": "node scripts/vite-run.mjs scripts/rhino-compare-main.ts --subject nightmare",
    "royal-compare": "node scripts/vite-run.mjs scripts/rhino-compare-main.ts --subject royal",
    "bench": "node scripts/vite-run.mjs scripts/bench-main.ts",
    "mulligan-data": "node scripts/vite-run.mjs scripts/mulligan-data-main.ts",
    "mulligan-fit": "node scripts/vite-run.mjs scripts/mulligan-fit-main.ts",
    "mulligan-eval": "node scripts/vite-run.mjs scripts/mulligan-eval-main.ts",
    "lethal-prevent": "node scripts/vite-run.mjs scripts/lethal-prevent-main.ts",
    "mulligan-model-fit": "node scripts/vite-run.mjs scripts/mulligan-model-fit-main.ts",
    "plan-value-data": "node scripts/vite-run.mjs scripts/plan-value-data-main.ts",
    "plan-value-fit": "node scripts/vite-run.mjs scripts/plan-value-fit-main.ts",
    "human-plan-value": "node scripts/vite-run.mjs scripts/human-plan-value-main.ts",
    "human-plan-value-report": "node scripts/vite-run.mjs scripts/human-plan-value-report-main.ts",
    "human-position": "node scripts/vite-run.mjs scripts/human-position-main.ts",
    "variant-plan-value": "node scripts/vite-run.mjs scripts/variant-plan-value-main.ts",
    "td": "node scripts/vite-run.mjs scripts/td-main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wistery-k/Shadowverse-Wb-Sim.git"
  },
  "bugs": {
    "url": "https://github.com/wistery-k/Shadowverse-Wb-Sim/issues"
  },
  "homepage": "https://github.com/wistery-k/Shadowverse-Wb-Sim#readme",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "preact": "^11.0.0"
  },
  "private": true,
  "type": "module"
}
